{
  "name": "@model-training/core",
  "version": "0.3.0",
  "description": "固定表述纠错：字典、生成、训练启动、评估核心",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
